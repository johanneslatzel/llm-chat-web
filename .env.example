# LLM Chat WebSearch — Configuration
# Copy to .env and fill in your values.

# Comma-separated search backends: duckduckgo, tavily, exaai, firecrawl.
# Unset or empty resolves to a single keyless duckduckgo entry; unknown names are skipped.
# LLM_CHAT_WEB_SEARCH_PROVIDERS=duckduckgo

# Per-provider API keys
# LLM_CHAT_WEB_SEARCH_TAVILY_API_KEY=
# LLM_CHAT_WEB_SEARCH_EXAAI_API_KEY=
# LLM_CHAT_WEB_SEARCH_FIRECRAWL_API_KEY=

# How providers are combined: single, parallel, fallback, weighted_random, round_robin
# LLM_CHAT_WEB_SEARCH_PROVIDER_STRATEGY=single

# LLM_CHAT_WEB_SEARCH_MAX_RESULTS=5
# LLM_CHAT_WEB_SEARCH_MAX_CHARS_PER_RESULT=2000
# LLM_CHAT_WEB_SEARCH_CONCURRENCY=3
# LLM_CHAT_WEB_FETCH_CONCURRENCY=3
# LLM_CHAT_WEB_FETCH_TIMEOUT_MS=5000
# LLM_CHAT_WEB_SEARCH_TIMEOUT_MS=4000
# LLM_CHAT_WEB_MAX_CONTENT_LENGTH_BYTES=10000000
# LLM_CHAT_WEB_MAX_PDF_PAGES=100
